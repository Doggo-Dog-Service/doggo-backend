# Este arquivo é um exemplo de como deve ser o arquivo .env.
# Copie o conteúdo deste arquivo para um arquivo chamado .env e
# preencha as variáveis de ambiente com os valores corretos.

MODE=DEVELOPMENT  # DEVELOPMENT, PRODUCTION, MIGRATE
DEBUG=True
WEB_CONCURRENCY=4
SECRET_KEY=django_insecure_gere_uma_chave_secreta
# DATABASE_URL=[database_url]
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# IP do computador na rede local, gravado aqui por `pdm dev`. Testar pelo celular (LAN) exige DEBUG=True: só assim
# o MY_IP entra em ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS e CSRF_TRUSTED_ORIGINS (frontend em http://<MY_IP>:5173)
MY_IP=127.0.0.1

# URL do Redis usado pelo Django Channels (WebSockets e localização em tempo real)
REDIS_URL=redis://127.0.0.1:6379
# Hosts aceitos pelo Django, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origens confiáveis para CSRF, separadas por vírgula
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Limite de requisições por IP nos endpoints de autenticação
AUTH_THROTTLE_RATE=10/min
# Número de proxies reversos na frente da aplicação (produção atrás de um proxy = 1; local = 0)
NUM_PROXIES=0
